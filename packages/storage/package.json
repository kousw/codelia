{
	"name": "@codelia/storage",
	"version": "0.1.93",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20 <25"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup --config tsup.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codelia/core": "0.1.93",
		"@codelia/logger": "0.1.93",
		"@codelia/shared-types": "0.1.93",
		"better-sqlite3": "^12.6.2",
		"image-size": "^2.0.2",
		"sharp": "^0.34.5"
	},
	"optionalDependencies": {
		"@codelia/tui-darwin-arm64": "0.1.93",
		"@codelia/tui-darwin-x64": "0.1.93"
	},
	"publishConfig": {
		"access": "public"
	}
}
