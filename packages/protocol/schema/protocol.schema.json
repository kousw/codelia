					"type": "string"
				},
				"goal_id": {
					"type": "string"
				},
				"revision": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"objective": {
					"type": "string"
				},
				"status": {
					"$ref": "#/$defs/GoalStatus"
				},
				"stop_reason": {
