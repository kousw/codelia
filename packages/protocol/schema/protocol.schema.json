							"type": "null"
						}
					]
				},
				"tokens_used": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"usage_known": {
					"type": "boolean"
				},
				"activation_id": {
					"type": "string"
				},
				"automatic_runs": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"created_at": {
					"type": "string"
				},
				"updated_at": {
					"type": "string"
				}
			},
			"required": [
				"session_id",
				"goal_id",
				"revision",
				"objective",
				"status",
				"token_budget",
				"tokens_used",
				"usage_known",
				"activation_id",
				"automatic_runs",
				"created_at",
				"updated_at"
			]
		},
		"GoalSetParams": {
			"type": "object",
			"properties": {
				"session_id": {
					"type": "string"
				},
				"goal_id": {
					"type": "string"
				},
				"revision": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"objective": {
					"type": "string"
				},
				"token_budget": {
					"x-codelia-presence": "tri-state",
					"anyOf": [
						{
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"GoalSnapshot": {
			"type": "object",
			"properties": {
