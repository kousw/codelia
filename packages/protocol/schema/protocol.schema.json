{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "codelia-protocol",
	"x-codelia-protocol-version": "0",
	"x-codelia-methods": {
		"initialize": {
			"kind": "request",
			"from": "ui",
			"params": {
				"$ref": "#/$defs/InitializeParams"
			},
			"result": {
				"$ref": "#/$defs/InitializeResult"
			}
		},
		"theme.set": {
			"kind": "request",
			"from": "ui",
			"params": {
				"$ref": "#/$defs/ThemeSetParams"
			},
			"result": {
				"$ref": "#/$defs/ThemeSetResult"
			},
			"capability": "supports_theme_set"
		},
		"goal.set": {
			"kind": "request",
			"from": "ui",
			"params": {
				"$ref": "#/$defs/GoalSetParams"
			},
			"result": {
				"$ref": "#/$defs/GoalSnapshot"
			},
			"capability": "supports_goals"
		},
		"run.steer": {
			"kind": "request",
			"from": "ui",
			"params": {
				"$ref": "#/$defs/RunSteerParams"
			},
			"result": {
				"$ref": "#/$defs/RunSteerResult"
			},
			"capability": "supports_run_steer"
		},
		"run.status": {
			"kind": "notification",
			"from": "runtime",
			"params": {
				"$ref": "#/$defs/RunStatusNotify"
			}
		},
		"run.metrics": {
			"kind": "notification",
			"from": "runtime",
			"params": {
				"$ref": "#/$defs/RunMetricsNotify"
			}
		},
		"agent.event": {
			"kind": "notification",
			"from": "runtime",
			"params": {
				"$ref": "#/$defs/AgentEventNotify"
			}
		},
		"client.tool.call": {
			"kind": "request",
			"from": "runtime",
			"params": {
				"$ref": "#/$defs/ClientToolCallRequestParams"
			},
			"result": {
				"$ref": "#/$defs/ClientToolCallResult"
			}
		},
		"client.tool.cancel": {
			"kind": "notification",
			"from": "runtime",
			"params": {
				"$ref": "#/$defs/ClientToolCancelParams"
			}
		}
	},
	"$defs": {
		"AgentEvent": {
			"oneOf": [
				{
					"$ref": "#/$defs/TextEvent"
				},
				{
					"$ref": "#/$defs/ReasoningEvent"
				},
				{
					"$ref": "#/$defs/TextDeltaEvent"
				},
				{
					"$ref": "#/$defs/ReasoningDeltaEvent"
				},
				{
					"$ref": "#/$defs/LlmRetryEvent"
				},
				{
					"$ref": "#/$defs/LlmStatusEvent"
				},
				{
					"$ref": "#/$defs/StepStartEvent"
				},
				{
					"$ref": "#/$defs/ToolCallEvent"
				},
				{
					"$ref": "#/$defs/ToolResultEvent"
				},
				{
					"$ref": "#/$defs/PermissionPreviewEvent"
				},
				{
					"$ref": "#/$defs/PermissionReadyEvent"
				},
				{
					"$ref": "#/$defs/StepCompleteEvent"
				},
				{
					"$ref": "#/$defs/CompactionStartEvent"
				},
				{
					"$ref": "#/$defs/CompactionCompleteEvent"
				},
				{
					"$ref": "#/$defs/HiddenUserMessageEvent"
				},
				{
					"$ref": "#/$defs/SteerAppliedEvent"
				},
				{
					"$ref": "#/$defs/FinalResponseEvent"
				}
			],
			"description": "Persisted and replayed: add variants and optional fields only.",
			"x-codelia-tag": "type"
		},
		"AgentEventNotify": {
			"type": "object",
			"properties": {
				"run_id": {
					"type": "string"
				},
				"seq": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"event": {
					"$ref": "#/$defs/AgentEvent"
				},
				"meta": {
					"type": "object",
					"properties": {
						"replayed": {
							"type": "boolean"
						}
					},
					"additionalProperties": {}
				}
			},
			"required": [
				"run_id",
				"seq",
				"event"
			]
		},
		"ApprovalMode": {
			"type": "string",
			"enum": [
				"minimal",
				"trusted",
				"full-access"
			]
		},
		"AttachmentRef": {
			"type": "object",
			"properties": {
				"attachment_id": {
					"type": "string"
				},
				"sha256": {
					"type": "string"
				},
				"byte_size": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"media_type": {
					"type": "string"
				},
				"display_name": {
					"type": "string"
				},
				"width": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"height": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"origin": {
					"type": "string",
					"enum": [
						"file",
						"clipboard_image"
					]
				}
			},
			"required": [
				"attachment_id",
				"sha256",
				"byte_size",
				"media_type",
				"display_name"
			],
			"description": "Immutable runtime-owned attachment metadata. No source path is retained."
		},
		"AttachmentRefPart": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "attachment_ref"
				},
				"attachment_ref": {
					"$ref": "#/$defs/AttachmentRef"
				},
				"image_ref": {
					"$ref": "#/$defs/ImageArtifactRef"
				}
			},
			"required": [
				"type",
				"attachment_ref"
			]
		},
		"AttachmentUploadLimits": {
			"type": "object",
			"properties": {
				"max_file_bytes": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"max_message_bytes": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"max_attachments": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"max_chunk_bytes": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"max_concurrent_uploads": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"max_file_bytes",
				"max_message_bytes",
				"max_attachments",
				"max_chunk_bytes",
				"max_concurrent_uploads"
			]
		},
		"AutoReviewConfinedLaunchIssue": {
			"type": "string",
			"enum": [
				"confined_launch_config_unavailable"
			]
		},
		"AutoReviewIssue": {
			"type": "string",
			"enum": [
				"unregistered_review_model",
				"review_reconfigure_required",
				"review_auth_unavailable",
				"review_auth_incompatible",
				"review_config_unavailable",
				"review_chat_provider_unresolved",
				"review_chat_provider_unsupported"
			]
		},
		"AutoReviewState": {
			"type": "string",
			"enum": [
				"off",
				"active",
				"unavailable"
			]
		},
		"ClientToolCallFailure": {
			"type": "object",
			"properties": {
				"ok": {
					"type": "boolean",
					"const": false
				},
				"error": {
					"type": "string"
				}
			},
			"required": [
				"ok",
				"error"
			]
		},
		"ClientToolCallRequestParams": {
			"type": "object",
			"properties": {
				"run_id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"arguments": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {}
				},
				"raw_arguments": {
					"type": "string"
				}
			},
			"required": [
				"run_id",
				"name",
				"raw_arguments"
			]
		},
		"ClientToolCallResult": {
			"oneOf": [
				{
					"$ref": "#/$defs/ClientToolCallSuccess"
				},
				{
					"$ref": "#/$defs/ClientToolCallFailure"
				}
			],
			"x-codelia-tag": "ok"
		},
		"ClientToolCallSuccess": {
			"type": "object",
			"properties": {
				"ok": {
					"type": "boolean",
					"const": true
				},
				"result": {}
			},
			"required": [
				"ok"
			]
		},
		"ClientToolCancelParams": {
			"type": "object",
			"properties": {
				"request_id": {
					"type": "string"
				},
				"run_id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"reason": {
					"type": "string",
					"enum": [
						"timeout"
					]
				}
			},
			"required": [
				"request_id",
				"run_id",
				"name",
				"reason"
			]
		},
		"CompactionCompleteEvent": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "compaction_complete"
				},
				"timestamp": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"compacted": {
					"type": "boolean"
				}
			},
			"required": [
				"type",
				"timestamp",
				"compacted"
			]
		},
		"CompactionStartEvent": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "compaction_start"
				},
				"timestamp": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"type",
				"timestamp"
			]
		},
		"ContentPart": {
			"oneOf": [
				{
					"$ref": "#/$defs/TextPart"
				},
				{
					"$ref": "#/$defs/ImagePart"
				},
				{
					"$ref": "#/$defs/ImageRefPart"
				},
				{
					"$ref": "#/$defs/AttachmentRefPart"
				},
				{
					"$ref": "#/$defs/DocumentPart"
				},
				{
					"$ref": "#/$defs/OtherPart"
				}
			],
			"x-codelia-tag": "type"
		},
		"DocumentPart": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "document"
				},
				"source": {
					"type": "object",
					"properties": {
						"data": {
							"type": "string"
						},
						"media_type": {
							"type": "string",
							"const": "application/pdf"
						}
					},
					"required": [
						"data",
						"media_type"
					]
				}
			},
			"required": [
				"type",
				"source"
			]
		},
		"FinalResponseEvent": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "final"
				},
				"content": {
					"type": "string"
				},
				"termination_reason": {
					"type": "string",
					"enum": [
						"normal",
						"max_steps",
						"permission_denied"
					]
				}
			},
			"required": [
				"type",
				"content"
			]
		},
